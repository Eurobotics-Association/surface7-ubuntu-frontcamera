# SPDX-License-Identifier: GPL-2.0-or-later
SURFACE7_OS_ID=ubuntu
SURFACE7_OS_VERSION=24.04
SURFACE7_ARCH=x86_64
SURFACE7_PRODUCT_PATTERN="Surface Pro 7"
# Build and deploy for the currently booted Ubuntu kernel. DKMS handles later
# kernel installations using their matching headers.
SURFACE7_TARGET_KERNEL="${SURFACE7_TARGET_KERNEL:-$(uname -r)}"
SURFACE7_LIBDIR=/usr/local/lib/surface7-ubuntu-frontcamera
SURFACE7_BACKUP_ROOT=/var/lib/surface7-ubuntu-frontcamera/backup
