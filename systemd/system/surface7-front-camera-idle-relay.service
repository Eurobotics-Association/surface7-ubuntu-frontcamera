[Unit]
Description=Surface Pro 7 V4L2 idle relay
Requires=surface7-camera-init.service
After=surface7-camera-init.service
ConditionPathExists=/dev/video83

ConditionPathExists=/run/surface7-camera/requested
ConditionPathExists=!/run/surface7-camera/failed

[Service]
Type=simple
RuntimeDirectory=surface7-ubuntu-frontcamera
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/rm -f /run/surface7-ubuntu-frontcamera/front.fifo
ExecStartPre=/usr/bin/mkfifo --mode=0600 /run/surface7-ubuntu-frontcamera/front.fifo
ExecStart=/usr/local/libexec/surface7-v4l2-idle-relay /dev/video83 /run/surface7-ubuntu-frontcamera/front.fifo 1280 720 30 1
Restart=no
TimeoutStopSec=5
KillMode=control-group

ExecStopPost=/usr/local/sbin/surface7-camera service-result
